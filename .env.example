# Zkopíruj jako .env a vyplň. Soubor .env nikdy nenahrávej na GitHub!

# Tajný klíč pro přihlašovací tokeny (aspoň 32 náhodných znaků). Vygeneruješ ho:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Doména, na které hra poběží (jen pro docker-compose s Caddy)
DOMAIN=hra.example.cz

TIMEZONE=Europe/Prague
